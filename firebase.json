{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "bloom-and-bunch-kl",
          "appId": "1:467512389115:android:58a843b318815641272f5e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bloom-and-bunch-kl",
          "configurations": {
            "android": "1:467512389115:android:58a843b318815641272f5e",
            "ios": "1:467512389115:ios:afb69b0d1a9299df272f5e",
            "macos": "1:467512389115:ios:afb69b0d1a9299df272f5e",
            "web": "1:467512389115:web:8610f60d14f65d6e272f5e",
            "windows": "1:467512389115:web:ffc76626fad25409272f5e"
          }
        }
      }
    }
  },
  "hosting": {
    "predeploy": [
      "node tool/validate_web_build.cjs"
    ],
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "orders",
      "ignore": [
        "node_modules",
        ".npm-cache",
        "test",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 18080,
      "websocketPort": 19150
    },
    "storage": {
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
