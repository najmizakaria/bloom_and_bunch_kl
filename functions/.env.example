# Copy to .env.<project-id> when ready; this file contains no credentials.
TOYYIBPAY_ENABLED=false
STORE_ORDER_MODE=demo
TOYYIBPAY_SANDBOX_CATEGORY_CODE=
TOYYIBPAY_RETURN_URL=https://YOUR-HOSTING-DOMAIN/payment-return.html
# Store TOYYIBPAY_SANDBOX_SECRET_KEY with Firebase Secret Manager, never here.
# Set STORE_ORDER_MODE=stripe_sandbox when the Stripe sandbox is configured.
STRIPE_SANDBOX_PAYMENT_METHOD_CONFIGURATION=
# STRIPE_SANDBOX_RETURN_URL=https://bloomandbunchkl.com/payment-return.html
# Set STRIPE_SANDBOX_SECRET_KEY and STRIPE_SANDBOX_WEBHOOK_SECRET in Firebase Secret Manager.
